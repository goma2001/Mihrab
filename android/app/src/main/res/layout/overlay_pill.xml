<?xml version="1.0" encoding="utf-8"?>
<!-- Floating prayer pill shown above other apps by FloatingButtonService:
     dark green pill, gold text. Two lines: the next prayer and its
     clock time above, the live countdown below, larger and bolder. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_pill_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_pill_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/overlay_pill_line1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="صلاتي"
        android:textColor="#C9A227"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/overlay_pill_line2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>
