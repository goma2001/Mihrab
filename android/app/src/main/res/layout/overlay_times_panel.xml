<?xml version="1.0" encoding="utf-8"?>
<!-- Today's-times panel opened by tapping the floating pill
     (FloatingButtonService): the same dark green with a gold edge as
     the pill. The title, Hijri line and rows are filled in by the
     service from the times payload; the open-app row opens صلاتي. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_panel_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_panel_bg"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/overlay_panel_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#C9A227"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlay_panel_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="✕"
            android:textColor="#C9A227"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/overlay_panel_hijri"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="2dp"
        android:textColor="#FFFFFF"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/overlay_panel_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="#C9A227" />

    <TextView
        android:id="@+id/overlay_panel_open_app"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="10dp"
        android:textColor="#C9A227"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
